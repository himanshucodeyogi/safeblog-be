# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Replace with your MongoDB Atlas or local connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/safeblog?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=safeblog_super_secret_jwt_key_development_only

# Optional Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
